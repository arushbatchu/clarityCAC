{
  "name": "clarity-frontend",
  "version": "1.1.0",
  "private": true,
  "description": "Clarity: rapid triage decision support. TypeScript frontend.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "standalone": "npm run build && node scripts/build-standalone.mjs",
    "serve": "python3 -m http.server 8080 --directory public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
